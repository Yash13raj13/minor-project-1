PROJECT_NAME="CivicLens Complaint Intelligence Platform"
API_V1_STR="/api/v1"
SECRET_KEY="civiclens-super-secret-development-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default to SQLite for immediate testing without local Postgres service running.
# To use PostgreSQL, uncomment below and comment SQLite:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/civiclens_db"
DATABASE_URL="sqlite:///./civiclens.db"

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
AI_SIMILARITY_THRESHOLD=0.82

